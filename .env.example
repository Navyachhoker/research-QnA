# --- Required ---
GROQ_API_KEY=your-groq-api-key
JWT_SECRET_KEY=generate-a-long-random-string-here

# --- LLM ---
GROQ_MODEL=openai/gpt-oss-120b
TEMPERATURE=0.2
MAX_TOKENS=1024

# --- Embeddings / retrieval ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
TOP_K=5
MAX_RETRIEVAL_DISTANCE=1.1

# --- Hybrid search + reranking ---
# BM25 keyword search fused with vector search (catches exact terms dense
# embeddings miss), plus a cross-encoder reranking pass. Both add latency
# and reranking loads a second (small) model into memory — disable either
# if you're on a memory/latency-constrained deployment.
ENABLE_HYBRID_SEARCH=true
ENABLE_RERANKING=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RETRIEVAL_CANDIDATE_POOL=20

# --- Chunking ---
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# --- Paths (relative to repo root by default) ---
CHROMA_PATH=./chroma_db
UPLOAD_DIR=./uploads
DATA_DIR=./data

# --- Uploads ---
MAX_UPLOAD_MB=25

# --- Database ---
DATABASE_URL=sqlite:///./researchgpt.db

# --- Auth ---
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- CORS: comma-separated list of allowed frontend origins ---
ALLOWED_ORIGINS=http://localhost:5173

ENVIRONMENT=development
